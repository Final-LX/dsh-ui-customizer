{
  "name": "dsh-ui-customizer",
  "version": "1.0.0",
  "private": true,
  "description": "Full DIY theme plugin for DSH web: color palettes, fonts, background image (upload/URL), glassmorphism, border radius.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "README.md"
  ],
  "scripts": {
    "test": "node tools/test-client.cjs && node tools/test-render.cjs",
    "wallpaper": "node tools/set-wallpaper.cjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6"
  }
}
